<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Set sensible defaults on install so the settings page isn't blank -->
    <data noupdate="1">
        <record id="fanto_ai_provider_default" model="ir.config_parameter">
            <field name="key">fanto_product_ai.provider</field>
            <field name="value">ollama</field>
        </record>
        <record id="fanto_groq_model_default" model="ir.config_parameter">
            <field name="key">fanto_product_ai.groq_model</field>
            <field name="value">groq/compound</field>
        </record>
        <record id="fanto_ollama_model_default" model="ir.config_parameter">
            <field name="key">fanto_product_ai.ollama_model</field>
            <field name="value">kimi-k2.5:cloud</field>
        </record>
        <record id="fanto_anthropic_model_default" model="ir.config_parameter">
            <field name="key">fanto_product_ai.anthropic_model</field>
            <field name="value">claude-sonnet-4-20250514</field>
        </record>
        <record id="fanto_openai_model_default" model="ir.config_parameter">
            <field name="key">fanto_product_ai.openai_model</field>
            <field name="value">gpt-4o</field>
        </record>
    </data>
</odoo>
