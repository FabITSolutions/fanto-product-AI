<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_ai_button" model="ir.ui.view">
        <field name="name">product.template.form.ai.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add button in the top action area -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="action"
                        name="%(fanto_product_ai.action_product_ai_description_wizard)d"
                        class="oe_stat_button"
                        icon="fa-magic"
                        string="AI Description"
                        groups="base.group_user"/>
            </xpath>
        </field>
    </record>

</odoo>
